{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "uv sync --frozen --only-dev",
  "buildCommand": "uv run --frozen --no-sync python scripts/build_web.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(apk|tar\\.gz)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
