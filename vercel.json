{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m pip install --quiet pygbag==0.9.3",
  "buildCommand": "python3 scripts/build_web.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(apk|tar\\.gz)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
