    <script type="application/javascript">

    globalThis.__canvas_resized = (self, ecw, ech) => {}

    // ------------------------------------------------------------ touch-besturing
    const GA = {
        mx: 0, my: 0, down: [], up: [], touch: false, mode: "menu",
        stickId: null, cx: 0, cy: 0, held: {},
    }

    // per modus: welke knoppen, met welk opschrift; null = knop verbergen
    const GA_MODES = {
        menu:     { stick: true, btn: { ok: "OK", back: "Terug" } },
        map:      { stick: true, btn: { ok: "Varen", shop: "Winkel", journal: "Dagboek", pause: "Menu" } },
        island:   { stick: true, btn: { attack: "Slaan", dash: "Dash", special: "Super", use: "Praat", eat: "Eten",
                                        weapon: "Wapen", journal: "Dagboek", pause: "Pauze" } },
        boss:     { stick: true, btn: { attack: "Slaan", dash: "Dash", special: "Super", eat: "Eten", weapon: "Wapen",
                                        pause: "Pauze" } },
        football: { stick: true, btn: { attack: "Schiet", dash: "Sprint", pause: "Stop" } },
    }

    // posities: [rechts, onder, diameter] in px vanaf de rechteronderhoek van het besturingsvlak.
    // Boog rond de grote knop; het geheel is max. 190 px breed en 283 px hoog (vóór schalen).
    const GA_POS = {
        attack: [16, 24, 92], ok: [16, 24, 92],
        dash: [124, 37, 66], special: [29, 137, 66], use: [105, 110, 60],
        weapon: [122, 197, 56], eat: [34, 227, 56],
    }
    const GA_CLUSTER_W = 190, GA_CLUSTER_H = 283
    const GA_TOP = ["back", "shop", "journal", "pause"]  // kleine knoppen bovenaan rechts

    function gaIsTouch() {
        return GA.touch || (window.matchMedia && matchMedia("(pointer: coarse)").matches)
    }

    function gaLayout() {
        const c = document.getElementById("canvas")
        const pad = document.getElementById("ga-pad")
        const vw = window.innerWidth, vh = window.innerHeight
        const ar = 16 / 9
        const touch = gaIsTouch()
        const portrait = vh > vw
        document.body.classList.toggle("ga-touch", touch)
        document.body.classList.toggle("ga-portrait", portrait)
        document.body.classList.toggle("ga-landscape", !portrait)
        let w, h, left, top
        if (portrait && touch) {
            // rechtop: spel bovenaan over de volle breedte, besturing in de ruimte eronder
            w = vw; h = Math.round(vw / ar)
            const minPad = 250
            if (vh - h < minPad) { h = Math.max(120, vh - minPad); w = Math.round(h * ar) }
            left = Math.round((vw - w) / 2); top = 0
            pad.style.left = "0px"; pad.style.right = "0px"; pad.style.top = h + "px"; pad.style.bottom = "0px"
        } else {
            // liggend of desktop: zo groot mogelijk, gecentreerd; knoppen zweven erover
            w = vw; h = Math.round(vw / ar)
            if (h > vh) { h = vh; w = Math.round(vh * ar) }
            left = Math.round((vw - w) / 2); top = Math.round((vh - h) / 2)
            pad.style.left = "0px"; pad.style.right = "0px"; pad.style.top = "0px"; pad.style.bottom = "0px"
        }
        c.style.left = left + "px"; c.style.top = top + "px"
        c.style.width = w + "px"; c.style.height = h + "px"
        c.style.right = "auto"; c.style.bottom = "auto"; c.style.margin = "0"
        gaPlaceButtons()
        if (GA.stickId === null) gaResetStick()  // niet resetten terwijl een vinger de joystick vasthoudt
    }

    function gaPlaceButtons() {
        const pad = document.getElementById("ga-pad")
        const ph = pad.clientHeight, pw = pad.clientWidth
        const portrait = document.body.classList.contains("ga-portrait")
        // knoppen blijven in de rechterhelft (links zit de joystick) en onder de rij kleine knoppen
        const k = Math.max(0.55, Math.min(portrait ? 1.3 : 0.85,
                                          (pw * 0.5 - 14) / GA_CLUSTER_W, (ph - 64) / GA_CLUSTER_H))
        const safeB = 12, safeR = 12
        for (const el of document.querySelectorAll(".ga-btn")) {
            const a = el.dataset.a
            if (GA_POS[a]) {
                const [r, b, d] = GA_POS[a]
                el.style.right = (safeR + r * k) + "px"; el.style.bottom = (safeB + b * k) + "px"
                el.style.width = el.style.height = (d * k) + "px"
                el.style.top = "auto"; el.style.left = "auto"
            }
        }
        // kleine knoppen in een rij bovenaan rechts
        let x = 10
        for (const a of GA_TOP) {
            const el = document.querySelector(`.ga-btn[data-a="${a}"]`)
            if (!el.classList.contains("on")) continue
            el.style.width = "70px"; el.style.height = "38px"
            el.style.top = "10px"; el.style.right = x + "px"; el.style.bottom = "auto"; el.style.left = "auto"
            x += 78
        }
    }

    function gaSetMode(mode) {
        const m = GA_MODES[mode] || GA_MODES.menu
        GA.mode = mode
        document.body.classList.toggle("ga-nostick", !m.stick)
        document.body.classList.toggle("ga-menu", mode === "menu" || mode === "map")
        for (const el of document.querySelectorAll(".ga-btn")) {
            const label = m.btn[el.dataset.a]
            el.classList.toggle("on", !!label)
            if (label) el.textContent = label
            if (!label && GA.held[el.dataset.a]) { GA.up.push(el.dataset.a); delete GA.held[el.dataset.a]; el.classList.remove("held") }
        }
        gaPlaceButtons()
    }
    window.gaSetMode = gaSetMode

    // door Python één keer per frame aangeroepen
    function gaTouchPoll() {
        const out = JSON.stringify({ mx: GA.mx, my: GA.my, down: GA.down, up: GA.up, active: gaIsTouch() })
        GA.down = []; GA.up = []
        return out
    }
    window.gaTouchPoll = gaTouchPoll

    function gaResetStick() {
        const zone = document.getElementById("ga-stick-zone")
        const base = document.getElementById("ga-stick-base")
        const knob = document.getElementById("ga-stick-knob")
        GA.cx = zone.clientWidth / 2; GA.cy = zone.clientHeight - Math.min(zone.clientHeight / 2, 120)
        base.style.left = GA.cx + "px"; base.style.top = GA.cy + "px"
        knob.style.transform = "translate(0px, 0px)"
        GA.mx = 0; GA.my = 0
    }

    function gaStickMove(ev) {
        const zone = document.getElementById("ga-stick-zone").getBoundingClientRect()
        const dx = ev.clientX - zone.left - GA.cx, dy = ev.clientY - zone.top - GA.cy
        const R = 56
        const len = Math.hypot(dx, dy)
        const f = len > R ? R / len : 1
        document.getElementById("ga-stick-knob").style.transform = `translate(${dx * f}px, ${dy * f}px)`
        GA.mx = Math.max(-1, Math.min(1, dx / R)); GA.my = Math.max(-1, Math.min(1, dy / R))
    }

    function gaUnlock() {
        // eerste aanraking = gebruikersinteractie: geluid en spel mogen starten
        GA.touch = GA.touch || false
        try { if (window.MM) window.MM.UME = true } catch (e) {}
    }

    function gaInit() {
        const zone = document.getElementById("ga-stick-zone")
        zone.addEventListener("pointerdown", (ev) => {
            ev.preventDefault()
            if (GA.stickId !== null) return
            GA.stickId = ev.pointerId
            zone.setPointerCapture(ev.pointerId)
            const r = zone.getBoundingClientRect()
            GA.cx = ev.clientX - r.left; GA.cy = ev.clientY - r.top
            const base = document.getElementById("ga-stick-base")
            base.style.left = GA.cx + "px"; base.style.top = GA.cy + "px"
            gaStickMove(ev)
        })
        zone.addEventListener("pointermove", (ev) => { if (ev.pointerId === GA.stickId) { ev.preventDefault(); gaStickMove(ev) } })
        const end = (ev) => { if (ev.pointerId === GA.stickId) { GA.stickId = null; gaResetStick() } }
        zone.addEventListener("pointerup", end)
        zone.addEventListener("pointercancel", end)

        for (const el of document.querySelectorAll(".ga-btn")) {
            const a = el.dataset.a
            el.addEventListener("pointerdown", (ev) => {
                ev.preventDefault(); ev.stopPropagation()
                el.setPointerCapture(ev.pointerId)
                if (!GA.held[a]) { GA.down.push(a); GA.held[a] = true; el.classList.add("held") }
                if (navigator.vibrate) try { navigator.vibrate(8) } catch (e) {}
            })
            const up = (ev) => { if (GA.held[a]) { GA.up.push(a); delete GA.held[a]; el.classList.remove("held") } }
            el.addEventListener("pointerup", up)
            el.addEventListener("pointercancel", up)
        }

        window.addEventListener("touchstart", () => {
            if (!GA.touch) { GA.touch = true; gaLayout() }
        }, { passive: true, capture: true })
        window.addEventListener("pointerdown", gaUnlock, { capture: true })
        document.getElementById("infobox").addEventListener("click", gaUnlock)
        // geen pinch-zoom / dubbeltik-zoom op iOS
        document.addEventListener("gesturestart", (e) => e.preventDefault())
        document.addEventListener("dblclick", (e) => e.preventDefault())

        // app-wissel / scherm uit: alles loslaten, anders blijft een knop of de joystick 'ingedrukt'
        const releaseAll = () => {
            for (const a of Object.keys(GA.held)) { GA.up.push(a); delete GA.held[a] }
            for (const el of document.querySelectorAll(".ga-btn.held")) el.classList.remove("held")
            GA.stickId = null; gaResetStick()
        }
        document.addEventListener("visibilitychange", () => { if (document.hidden) releaseAll() })
        window.addEventListener("blur", releaseAll)

        window.addEventListener("resize", gaLayout)
        window.addEventListener("orientationchange", () => setTimeout(gaLayout, 150))
        gaSetMode("menu")
        gaLayout()
        // de canvas krijgt pas later zijn echte grootte van SDL: nog even blijven bijstellen
        let n = 0
        const iv = setInterval(() => { gaLayout(); if (++n > 40) clearInterval(iv) }, 500)
    }

    async function custom_onload(debug_hidden) {
        pyconsole.hidden = debug_hidden
        transfer.hidden = debug_hidden
        show_infobox()
        gaInit()
    }

    function custom_prerun() {}
    function custom_postrun() {}

    function debug() {
        python.config.debug = true
        custom_onload(false)
        Module.PyRun_SimpleString("shell.uptime()")
    }

    function info_inline(data) { document.getElementById("info").innerHTML = data }
    function info_online(url) { fetch(url).then((r) => r.text()).then(info_inline).catch(console.warn) }
    function frame_online(url) { window.frames["iframe"].location = url }

    </script>

